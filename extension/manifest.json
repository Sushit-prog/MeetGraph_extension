{
  "manifest_version": 3,
  "name": "MeetGraph - Meeting Intelligence",
  "version": "1.0.0",
  "description": "Real-time meeting assistant that captures transcripts, extracts decisions and action items, and surfaces relevant historical context",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "https://meet.google.com/*",
    "https://zoom.us/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content-meet.js"],
      "css": ["overlay/sidebar.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://zoom.us/*"],
      "js": ["content-zoom.js"],
      "css": ["overlay/sidebar.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "overlay/sidebar.html",
        "overlay/sidebar.css",
        "overlay/sidebar.js",
        "lib/api-client.js",
        "icons/*"
      ],
      "matches": [
        "https://meet.google.com/*",
        "https://zoom.us/*"
      ]
    }
  ],
  "action": {
    "default_title": "MeetGraph"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
